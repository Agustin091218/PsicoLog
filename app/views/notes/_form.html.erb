<%= form_with model: [patient, note], local: true, class: "space-y-4" do |f| %>
  <% if note.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-lg p-4 text-sm text-red-700">
      <p class="font-medium"><%= pluralize(note.errors.count, "error") %> prevented saving:</p>
      <ul class="list-disc list-inside mt-1">
        <% note.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :note_type, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.select :note_type, Note.note_types.map { |t| [t.humanize, t] }, {},
          class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none text-sm" %>
    </div>

    <div>
      <%= f.label :recorded_at, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.datetime_local_field :recorded_at,
          class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none text-sm" %>
    </div>
  </div>

  <div data-controller="note-editor">
    <div class="flex items-center gap-1 mb-2 pb-2 border-b border-gray-200">
      <button type="button" data-action="note-editor#bold"
          class="px-2 py-1 text-xs font-bold text-gray-600 hover:bg-gray-100 rounded">B</button>
      <button type="button" data-action="note-editor#italic"
          class="px-2 py-1 text-xs italic text-gray-600 hover:bg-gray-100 rounded">I</button>
      <button type="button" data-action="note-editor#list"
          class="px-2 py-1 text-xs text-gray-600 hover:bg-gray-100 rounded">List</button>
      <span class="mx-2 text-gray-200">|</span>
      <button type="button" data-action="note-editor#quickNote"
          class="px-2 py-1 text-xs text-gray-600 hover:bg-gray-100 rounded">Quick Note</button>
    </div>

    <div>
      <%= f.label :content, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_area :content, rows: 14, required: true,
          data: { note_editor_target: "textarea" },
          class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none text-sm font-mono" %>
    </div>
  </div>

  <%= f.submit class: "w-full py-2 px-4 bg-brand-600 text-white rounded-lg hover:bg-brand-700 cursor-pointer font-medium" %>
<% end %>
