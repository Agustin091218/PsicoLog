<%= render "shared/flash" %>

<h1 class="text-2xl font-semibold text-gray-900 mb-1">Nueva nota</h1>
<p class="text-sm text-gray-400 mb-6"><%= @patient.full_name %></p>

<div class="bg-white rounded-2xl border border-gray-100 p-6 max-w-4xl shadow-sm">
  <%= render "form", patient: @patient, note: @note %>
</div>

<div class="mt-4">
  <%= link_to patient_notes_path(@patient), class: "inline-flex items-center gap-1.5 text-sm text-gray-400 hover:text-gray-600 transition-colors" do %>
    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>
    Cancelar
  <% end %>
</div>
