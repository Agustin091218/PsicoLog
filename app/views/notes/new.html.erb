<%= render "shared/flash" %>

<h1 class="text-2xl font-semibold mb-1">Nueva nota</h1>
<p class="text-sm text-gray-500 mb-6"><%= @patient.full_name %></p>

<div class="bg-white rounded-lg border border-gray-200 p-6 max-w-2xl">
  <%= render "form", patient: @patient, note: @note %>
</div>

<div class="mt-4">
  <%= link_to "Cancelar", patient_notes_path(@patient), class: "text-sm text-gray-500 hover:underline" %>
</div>
