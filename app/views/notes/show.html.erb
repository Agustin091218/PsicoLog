<%= render "shared/flash" %>

<div class="flex items-center justify-between mb-6">
  <div>
    <span class="text-xs font-medium text-brand-600 bg-brand-50/80 px-2.5 py-1 rounded-lg"><%= @note.translated_type %></span>
    <p class="text-sm text-gray-400 mt-1.5"><%= @patient.full_name %> — <%= l(@note.recorded_at, format: :long) %></p>
  </div>
  <div class="flex items-center gap-2">
    <%= link_to edit_patient_note_path(@patient, @note), class: "inline-flex items-center gap-1.5 px-3 py-2 text-sm text-gray-600 hover:bg-gray-100 rounded-xl transition-colors" do %>
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/></svg>
      Editar
    <% end %>
    <%= button_to patient_note_path(@patient, @note), method: :delete,
        class: "inline-flex items-center gap-1.5 px-3 py-2 text-sm text-red-400 hover:text-red-600 hover:bg-red-50 rounded-xl transition-colors",
        form: { data: { turbo_confirm: "¿Archivar esta nota?" } } do %>
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/></svg>
      Archivar
    <% end %>
  </div>
</div>

<div class="bg-white rounded-2xl border border-gray-100 p-6 shadow-sm">
  <div class="text-sm text-gray-700 leading-relaxed">
    <%= markdown(@note.content) %>
  </div>
</div>

<div class="mt-6">
  <%= link_to patient_notes_path(@patient), class: "inline-flex items-center gap-1.5 text-sm text-gray-400 hover:text-gray-600 transition-colors" do %>
    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/></svg>
    Todas las notas
  <% end %>
</div>
