<%= render "shared/flash" %>

<div class="flex items-center justify-between mb-6">
  <div>
    <span class="text-xs font-medium text-brand-600 bg-brand-50 px-2 py-1 rounded">
      <%= @note.note_type.humanize %>
    </span>
    <p class="text-sm text-gray-500 mt-1">
      <%= @patient.full_name %> — <%= @note.recorded_at.strftime("%B %d, %Y at %H:%M") %>
    </p>
  </div>
  <div class="flex items-center gap-3">
    <%= link_to "Edit", edit_patient_note_path(@patient, @note),
        class: "text-sm text-gray-500 hover:text-gray-700" %>
    <%= button_to "Archive", patient_note_path(@patient, @note), method: :delete,
        class: "text-sm text-red-500 hover:text-red-700",
        form: { data: { turbo_confirm: "Archive this note?" } } %>
  </div>
</div>

<div class="bg-white rounded-lg border border-gray-200 p-6">
  <div class="text-sm text-gray-700 leading-relaxed">
    <%= simple_format(@note.content) %>
  </div>
</div>

<div class="mt-4">
  <%= link_to "All notes", patient_notes_path(@patient), class: "text-sm text-gray-500 hover:underline" %>
</div>
