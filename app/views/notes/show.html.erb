<%= render "shared/flash" %>

<div class="max-w-2xl">
  <%= link_to patient_notes_path(@patient), class: "inline-flex items-center gap-1.5 text-sm text-gray-400 hover:text-gray-600 transition-colors mb-6" do %>
    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/></svg>
    Notas de <%= @patient.full_name %>
  <% end %>

  <div class="flex items-start justify-between mb-8">
    <div>
      <span class="text-xs font-medium px-2.5 py-1 rounded-full <%= @note.note_type == 'session_note' ? 'bg-green-50 text-green-700' : (@note.note_type == 'initial_interview' ? 'bg-amber-50 text-amber-700' : ( @note.note_type == 'follow_up' ? 'bg-blue-50 text-blue-700' : (@note.note_type == 'emergency' ? 'bg-red-50 text-red-700' : 'bg-gray-100 text-gray-600'))) %>"><%= @note.translated_type %></span>
      <p class="text-sm text-gray-400 mt-2"><%= l(@note.recorded_at, format: :long) %></p>
    </div>
    <div class="flex items-center gap-1">
      <%= link_to edit_patient_note_path(@patient, @note), class: "inline-flex items-center gap-1.5 px-3 py-2 text-sm text-gray-500 hover:text-gray-800 hover:bg-gray-100 rounded-xl transition-colors" do %>
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/></svg>
        Editar
      <% end %>
      <%= button_to patient_note_path(@patient, @note), method: :delete,
          class: "inline-flex items-center gap-1.5 px-3 py-2 text-sm text-gray-400 hover:text-red-600 hover:bg-red-50 rounded-xl transition-colors",
          form: { data: { turbo_confirm: "¿Archivar esta nota?" } } do %>
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/></svg>
        Archivar
      <% end %>
    </div>
  </div>

  <div class="text-gray-700 leading-relaxed text-[15px] [&_p]:mb-3 [&_h2]:text-lg [&_h2]:font-semibold [&_h2]:text-gray-900 [&_h2]:mt-6 [&_h2]:mb-2 [&_ul]:list-disc [&_ul]:ml-5 [&_ol]:list-decimal [&_ol]:ml-5 [&_li]:mb-1">
    <%= sanitize(@note.content) %>
  </div>
</div>
