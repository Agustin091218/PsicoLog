<%= render "shared/flash" %>

<div class="max-w-sm mx-auto mt-24">
  <div class="text-center mb-10">
    <img src="/logo.svg" alt="Psicolog" class="w-14 h-14 mx-auto mb-6">
    <h1 class="text-2xl font-semibold text-gray-900 tracking-tight">Iniciar sesión</h1>
    <p class="text-sm text-gray-400 mt-2">Ingresá a tu cuenta para continuar</p>
  </div>

  <%= form_with url: sessions_path, scope: :session, local: true, class: "space-y-5" do |f| %>
    <div>
      <%= f.label :email, "Correo electrónico", class: "block text-sm font-medium text-gray-500 mb-2" %>
      <%= f.email_field :email, required: true, autofocus: true, placeholder: "tu@email.com",
          class: "w-full px-0 py-2.5 border-0 border-b border-gray-200 focus:ring-0 focus:border-brand-500 outline-none text-sm bg-transparent placeholder:text-gray-300 transition-colors" %>
    </div>

    <div>
      <%= f.label :password, "Contraseña", class: "block text-sm font-medium text-gray-500 mb-2" %>
      <%= f.password_field :password, required: true, placeholder: "••••••••",
          class: "w-full px-0 py-2.5 border-0 border-b border-gray-200 focus:ring-0 focus:border-brand-500 outline-none text-sm bg-transparent placeholder:text-gray-300 transition-colors" %>
    </div>

    <%= f.submit "Ingresar", class: "w-full py-3 px-4 bg-brand-600 text-white rounded-xl hover:bg-brand-700 cursor-pointer font-medium text-sm transition-colors mt-8" %>
  <% end %>

  <p class="mt-8 text-sm text-gray-400 text-center">
    ¿No tenés cuenta? <%= link_to "Registrate", new_user_path, class: "text-brand-600 hover:text-brand-700 font-medium transition-colors" %>
  </p>
</div>
