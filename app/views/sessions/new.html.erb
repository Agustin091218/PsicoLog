<%= render "shared/flash" %>

<div class="max-w-sm mx-auto mt-20">
  <div class="text-center mb-8">
    <img src="/logo.svg" alt="Psicolog" class="w-14 h-14 mx-auto mb-4 drop-shadow-lg">
    <h1 class="text-2xl font-semibold text-gray-900">Iniciar sesión</h1>
  </div>

  <%= form_with url: sessions_path, scope: :session, local: true, class: "space-y-4" do |f| %>
    <div>
      <%= f.label :email, class: "block text-sm font-medium text-gray-600 mb-1.5" %>
      <%= f.email_field :email, required: true, autofocus: true,
          class: "w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 outline-none text-sm bg-white shadow-sm transition-shadow" %>
    </div>

    <div>
      <%= f.label :password, class: "block text-sm font-medium text-gray-600 mb-1.5" %>
      <%= f.password_field :password, required: true,
          class: "w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 outline-none text-sm bg-white shadow-sm transition-shadow" %>
    </div>

    <%= f.submit "Ingresar", class: "w-full py-2.5 px-4 bg-brand-600 text-white rounded-xl hover:bg-brand-700 cursor-pointer font-medium text-sm transition-colors shadow-sm" %>
  <% end %>

  <p class="mt-6 text-sm text-gray-400 text-center">
    ¿No tienes cuenta? <%= link_to "Registrarse", new_user_path, class: "text-brand-600 hover:text-brand-700 font-medium transition-colors" %>
  </p>
</div>
