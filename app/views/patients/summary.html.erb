<%= render "shared/flash" %>

<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-semibold text-gray-900">Resumen de sesión</h1>
  <%= link_to new_patient_note_path(@patient), class: "inline-flex items-center gap-1.5 px-4 py-2.5 bg-brand-600 text-white text-sm font-medium rounded-xl hover:bg-brand-700 transition-colors shadow-sm" do %>
    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/></svg>
    Nueva nota
  <% end %>
</div>

<div class="bg-white rounded-2xl border border-gray-100 p-6 shadow-sm mb-6">
  <h2 class="text-xl font-semibold text-gray-900 mb-1"><%= @patient.full_name %></h2>
  <p class="text-sm text-gray-400 flex items-center gap-1.5">
    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 10 10 10-4.48 10-10S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"/></svg>
    <% last_note = @patient.notes.active.ordered.first %>
    <%= last_note ? "Última sesión: #{l(last_note.recorded_at, format: :long)}" : "Sin sesiones aún" %>
  </p>
</div>

<h3 class="text-lg font-semibold text-gray-900 mb-4">Notas recientes</h3>

<% if @recent_notes.any? %>
  <div class="space-y-4">
    <% @recent_notes.each do |note| %>
      <div class="bg-white rounded-2xl border border-gray-100 p-5 shadow-sm hover:shadow-md transition-shadow">
        <div class="flex items-center justify-between mb-3">
          <span class="text-xs font-medium text-brand-600 bg-brand-50/80 px-2.5 py-1 rounded-lg"><%= note.translated_type %></span>
          <span class="text-xs text-gray-400"><%= l(note.recorded_at, format: :long) %></span>
        </div>
        <div class="text-sm text-gray-600 leading-relaxed">
          <%= markdown(truncate(note.content, length: 200, escape: false)) %>
        </div>
        <%= link_to patient_note_path(@patient, note), class: "inline-flex items-center gap-1 mt-3 text-sm text-brand-600 hover:text-brand-700 font-medium transition-colors" do %>
          Leer nota completa
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"/></svg>
        <% end %>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="text-center py-16 bg-white rounded-2xl border border-gray-100 shadow-sm">
    <div class="w-16 h-16 bg-gray-100 rounded-2xl flex items-center justify-center mx-auto mb-4">
      <svg class="w-8 h-8 text-gray-400" viewBox="0 0 24 24" fill="currentColor"><path d="M19 3h-4.18C14.4 1.84 13.3 1 12 1c-1.3 0-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm2 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"/></svg>
    </div>
    <p class="text-gray-400 text-sm">Aún no hay notas. ¿Listo para comenzar esta sesión?</p>
  </div>
<% end %>

<div class="mt-6 flex items-center gap-4">
  <%= link_to patient_notes_path(@patient), class: "inline-flex items-center gap-1.5 text-sm text-gray-400 hover:text-gray-600 transition-colors" do %>
    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"/></svg>
    Todas las notas
  <% end %>
  <%= link_to patients_path, class: "inline-flex items-center gap-1.5 text-sm text-gray-400 hover:text-gray-600 transition-colors" do %>
    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/></svg>
    Volver a pacientes
  <% end %>
</div>
