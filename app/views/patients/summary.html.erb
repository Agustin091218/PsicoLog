<%= render "shared/flash" %>

<div class="flex items-center justify-between mb-10">
  <div>
    <%= link_to patient_path(@patient), class: "text-sm text-gray-400 hover:text-gray-600 transition-colors mb-1 inline-block" do %>
      &larr; Volver al paciente
    <% end %>
    <h1 class="text-3xl font-bold text-gray-900 tracking-tight">Resumen de sesión</h1>
  </div>
  <%= link_to new_patient_note_path(@patient), class: "inline-flex items-center gap-2 px-4 py-2.5 bg-brand-600 text-white text-sm font-medium rounded-xl hover:bg-brand-700 transition-colors" do %>
    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/></svg>
    Nueva nota
  <% end %>
</div>

<div class="mb-8">
  <h2 class="text-2xl font-semibold text-gray-900"><%= @patient.full_name %></h2>
  <% last_note = @patient.notes.active.ordered.first %>
  <p class="text-sm text-gray-400 mt-1">
    <%= last_note ? "Última sesión: #{l(last_note.recorded_at, format: :long)}" : "Sin sesiones aún" %>
  </p>
</div>

<div class="border-t border-gray-100 pt-8 mb-6">
  <h3 class="text-xs font-semibold uppercase tracking-widest text-gray-400 mb-6">Notas recientes</h3>
</div>

<% if @recent_notes.any? %>
  <div class="space-y-6">
    <% @recent_notes.each do |note| %>
      <div class="group">
        <div class="flex items-center gap-3 mb-2">
          <span class="text-xs font-semibold text-brand-600 bg-brand-50 px-2.5 py-1 rounded-md"><%= note.translated_type %></span>
          <span class="text-xs text-gray-400"><%= l(note.recorded_at, format: :long) %></span>
        </div>
        <div class="text-sm text-gray-600 leading-relaxed prose prose-sm max-w-none">
          <%= truncate(strip_tags(note.content), length: 250) %>
        </div>
        <%= link_to patient_note_path(@patient, note), class: "inline-flex items-center gap-1.5 mt-2 text-sm text-brand-600 hover:text-brand-700 font-medium transition-colors" do %>
          Leer nota completa
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"/></svg>
        <% end %>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="text-center py-20">
    <div class="w-16 h-16 bg-gray-50 rounded-2xl flex items-center justify-center mx-auto mb-4">
      <svg class="w-8 h-8 text-gray-300" viewBox="0 0 24 24" fill="currentColor"><path d="M19 3h-4.18C14.4 1.84 13.3 1 12 1c-1.3 0-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm-2 14l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/></svg>
    </div>
    <p class="text-gray-400 text-sm mb-1">Sin notas registradas</p>
    <p class="text-gray-300 text-xs">Creá la primera nota de este paciente para ver su historial.</p>
  </div>
<% end %>
